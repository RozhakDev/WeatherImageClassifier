# Server & Application Configuration
APP_NAME=WeatherImageClassifier API
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Machine Learning Model Configuration
MODEL_PATH=models/weather_classifier.keras
MODEL_VERSION=1.0.0
TARGET_IMAGE_SIZE=[224, 224]
COLOR_MODE=RGB
COLOR_CHANNELS=3
SCORE_PRECISION=6

# File Ingestion & Preprocessing Security
MAX_UPLOAD_BYTES=10485760
UPLOAD_CHUNK_SIZE_BYTES=65536
MAX_IMAGE_PIXELS=10000000
ALLOWED_FORMATS=["JPEG", "PNG"]

# API Documentation Configuration
DOCS_URL=/docs
REDOC_URL=/redoc
OPENAPI_URL=/openapi.json

# HTTP Security Headers
SECURITY_HSTS_HEADER=max-age=31536000; includeSubDomains
SECURITY_FRAME_OPTIONS=DENY
SECURITY_CONTENT_TYPE_OPTIONS=nosniff
DEFAULT_CONTENT_SECURITY_POLICY=default-src 'self'
